# CONTOH .env.example untuk toko-latihan (soal 10-02).
# Simpan di project sebagai ".env.example" (dengan titik di depan).
# Semua nilai di sini PLACEHOLDER. Nilai asli hanya ada di .env server.

APP_NAME="Toko Latihan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toko.contoh.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toko_latihan
DB_USERNAME=toko_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.contoh.test
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="toko@contoh.test"
MAIL_FROM_NAME="${APP_NAME}"

# Variabel buatan sendiri (dibaca lewat config/toko.php, bukan env() di controller)
TOKO_NAMA="Toko Latihan"
TOKO_PAYMENT_SECRET=
