# ============================================================
# SOAL 01 — .dockerignore
# ============================================================
# Tambahkan file/folder yang TIDAK perlu masuk ke Docker image.
# Docker build context = semua file yang di-COPY dari host ke image.
# .dockerignore mencegah file besar/tidak perlu dikirim ke Docker daemon.
#
# Test efek .dockerignore:
#   docker build --no-cache -t my-app:test . 2>&1 | grep "Sending build context"
#   → Tanpa .dockerignore: context bisa GB+
#   → Dengan .dockerignore: context lebih kecil
# ============================================================

# ─── Version Control ───────────────────────────────
.git
.gitignore
.gitattributes

# ─── Dependencies (di-install saat build) ──────────
node_modules/
bower_components/

# ─── Build Artifacts (di-generate ulang) ───────────
dist/
build/
.vite/
.next/
.nuxt/
output/

# ─── Development Files ──────────────────────────────
.env
.env.*
.env.local
.env.development
.env.production
*.md
LICENSE
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Test & Coverage ───────────────────────────────
coverage/
.nyc_output/
test-results/
__tests__/
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
vitest.config.*
playwright.config.*

# ─── Editor & IDE ──────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── CI/CD & Docker ────────────────────────────────
docker-compose*.yml
docker-compose*.yaml
Dockerfile
.dockerignore
.docker/

# ─── Documentation ─────────────────────────────────
docs/
*.md
CHANGELOG*
CONTRIBUTING*

# ─── Temporary & Cache ─────────────────────────────
tmp/
temp/
.cache/
.parcel-cache/
