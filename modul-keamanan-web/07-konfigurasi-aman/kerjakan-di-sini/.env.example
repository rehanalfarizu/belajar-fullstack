# Template environment untuk 01-server-config.js
#
# Cara pakai:
#   1. Salin file ini menjadi .env  (cp .env.example .env)
#   2. Isi nilai di .env dengan buatanmu sendiri
#   3. JANGAN commit .env. File ini (.env.example) boleh di-commit karena isinya kosong.
#
# Tips bikin secret acak:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3070

# Password database (lab ini tidak benar-benar konek ke database, ini contoh saja)
DB_PASSWORD=

# API key layanan pihak ketiga (contoh saja)
API_KEY=

# Secret untuk menandatangani cookie session
SESSION_SECRET=
